# Set these in your host's dashboard (or export them before `npm start`).
NODE_ENV=production        # enables the Secure + __Host- cookie, HSTS and CSP upgrade
PORT=3000
TRUST_PROXY=1              # number of reverse proxies in front (Render/Railway/Nginx = 1); without it every user shares one IP for rate limits
DATABASE_URL=postgres://avnadmin:PASSWORD@pg-xxxx.aivencloud.com:12345/defaultdb?sslmode=require   # Aiven "Service URI"
DATABASE_CA=                # paste Aiven's CA certificate (PEM) here, or use DATABASE_CA_FILE=/etc/secrets/ca.pem
# DB_POOL_MAX=10            # keep below your plan's connection limit
SCRYPT_N=65536             # password hashing cost; use 32768 on tiny (<512MB) hosts
ADMIN_USERS=yournick        # comma separated nicks that can open /admin.html (register the nick first!)
# EXTRA_IMG_HOSTS=i.imgur.com   # extra image hosts allowed for admin-made skins and cases (also added to the CSP)
# ALLOWED_ORIGINS=https://buffgrade.example.com   # optional strict origin allowlist
