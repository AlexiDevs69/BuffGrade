# Set these in your host's dashboard (or export them before `npm start`).
NODE_ENV=production        # enables the Secure + __Host- cookie, HSTS and CSP upgrade
PORT=3000
TRUST_PROXY=1              # number of reverse proxies in front (Render/Railway/Nginx = 1); without it every user shares one IP for rate limits
DB_PATH=/var/data/buffgrade.db   # MUST be on a persistent disk
SCRYPT_N=65536             # password hashing cost; use 32768 on tiny (<512MB) hosts
# ALLOWED_ORIGINS=https://buffgrade.example.com   # optional strict origin allowlist
